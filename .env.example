# ==============================================================================
# SnapCraft Environment Configuration
# ==============================================================================

# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional alias supported if you use Supabase's newer publishable key naming:
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public Site URL (use your Render URL in production, e.g. https://snapcraft.onrender.com)
VITE_SITE_URL=http://localhost:3000
